# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Google Maps Platform
GOOGLE_MAPS_API_KEY=server-only-google-places-api-key
GOOGLE_MONTHLY_REQUEST_LIMIT=900

# Single-user access
ALLOWED_USER_EMAIL=owner@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Website crawler
CRAWLER_TIMEOUT_MS=7000
CRAWLER_MAX_PAGES_PER_BUSINESS=10
CRAWLER_MAX_RESPONSE_BYTES=1048576
CRAWLER_CONCURRENCY=2
CRAWLER_USER_AGENT=LeadgyujtoBot/1.0 (+https://example.com; contact: owner@example.com)
